# ---------------------------------------------------------------------------
# Great Lakes Shipping Containers — environment variables
# Copy to .env.local for local development. In production, set these in your
# host's dashboard (e.g. Vercel → Project → Settings → Environment Variables).
# NEVER commit real values. Only NEXT_PUBLIC_* values reach the browser.
# ---------------------------------------------------------------------------

# Canonical site URL (no trailing slash). Used for canonicals, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://glsc-mi.com

# --- Email delivery (REQUIRED for forms to work) ---------------------------
# Resend API key (server-only). Create at https://resend.com/api-keys with "Sending access".
RESEND_API_KEY=
# Verified sender. The domain must be verified in Resend (SPF + DKIM DNS records).
INQUIRY_FROM_EMAIL="Great Lakes Shipping Containers <quotes@glsc-mi.com>"
# Recipient(s). Defaults to chris@stierenterprise.com when unset. Comma-separate for several.
INQUIRY_TO_EMAIL=chris@stierenterprise.com

# --- Spam protection (optional, recommended) --------------------------------
# Cloudflare Turnstile. Set BOTH or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Extra allowed origins for the form endpoint (comma-separated), e.g. a www. host.
# Same-host requests are always allowed.
ALLOWED_ORIGINS=https://www.glsc-mi.com

# --- Analytics & Search Console (optional) ----------------------------------
# GA4 measurement ID, format G-XXXXXXXXXX. Leave blank to load no analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification token (content value only).
GOOGLE_SITE_VERIFICATION=

# --- Testing only -----------------------------------------------------------
# Points the mailer at a mock server in automated tests. Do NOT set in production.
# RESEND_API_URL=http://localhost:3999
